# Talocode Cloud API key for billing
TALOCODE_API_KEY=tk_dev_xxxxxxxxxxxx

# Talocode Cloud base URL (default: https://api.talocode.xyz)
TALOCODE_BASE_URL=https://api.talocode.xyz

# Set to "true" to enable mock provider (dev only)
CODRA_CLOUD_MOCK=true

# Port to listen on (default: 3001)
PORT=3001
